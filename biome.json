{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.js",
      "tests/**/*.mjs",
      "scripts/**/*.mjs",
      "site/*.js"
    ]
  },
  "formatter": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noVoidTypeReturn": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/game/**",
        "src/sim/sim.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off",
            "useIterableCallbackReturn": "off",
            "noExplicitAny": "off",
            "noFunctionAssign": "off",
            "noImplicitAnyLet": "off"
          },
          "style": {
            "useTemplate": "off",
            "useConst": "off"
          },
          "complexity": {
            "noCommaOperator": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
